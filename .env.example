# Copy this file to .env only if you need to override a default.
# The application runs without any .env file.

# API server port (the Vite dev server proxies /api to this port)
PORT=3001

# Path to the SQLite database file (default: data/voltflow.db)
# DB_PATH=data/voltflow.db

# JWT signing secret. If empty, a random secret is generated once and stored in
# data/.jwt-secret (git-ignored). Never commit a real secret.
# JWT_SECRET=

# Simulated charging speed: 1 real second equals this many simulated seconds
# SIM_SPEED=60
